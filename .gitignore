# Local-only policy:
# Keep all hidden files and folders ignored except `.github/`.
# Do not override this rule when asked to "commit everything".
.*
**/.*
!.gitignore
!.github/
!.github/**

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
publication_strategy_and_archive/mirror/_site/
.cache/
!publication_strategy_and_archive/mirror/lib/
!publication_strategy_and_archive/mirror/lib/*.js

# Private internal documents (build in public, but these stay private)
publication_strategy_and_archive/future_publication_strategy.md
publication_strategy_and_archive/publication_analysis_results.md

# Stray root-level generated assets
Generated Image*.png
output/

# Third-party research PDFs (downloaded papers — copyright risk for public distribution)
**/papers/**/*.pdf

# Generated long-form course renders
publications/autonomous-agents/essays/*/artifacts/video/*Timed Slides.mp4

# --- Repository Content Hygiene Policy ---
# Globally ignore PDF, Video, and Audio assets to keep the Git footprint small.
# Images are NOT ignored to preserve inline essay rendering.
*.pdf
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.m4a
*.aac

# Whitelist: Course Blueprints (visual anchors for the series)
!*Blueprint.mp4
!*Blueprint.mp3

# Whitelist: Load-bearing Reader Assets
!publications/binding-gap/artifacts/video/The_Binding_Gap_explainer.mp4

# Whitelist: Active Notebook Sources (Small seed papers)
!publications/orchestration-paradigm/**/notebook_sources/**/*.pdf
!publications/orchestration-paradigm/**/papers/pdf/**/*.pdf

# Whitelist: Autonomy-Tax Gap (PDFs with no full-text conversion yet)
!publications/autonomy-tax/sources/raw/073*.pdf
!publications/autonomy-tax/sources/raw/074*.pdf
!publications/autonomy-tax/sources/raw/075*.pdf
!publications/autonomy-tax/sources/raw/076*.pdf
!publications/autonomy-tax/sources/raw/077*.pdf
!publications/autonomy-tax/sources/raw/078*.pdf
!publications/autonomy-tax/sources/raw/079*.pdf
!publications/autonomy-tax/sources/raw/080*.pdf
!publications/autonomy-tax/sources/raw/081*.pdf
