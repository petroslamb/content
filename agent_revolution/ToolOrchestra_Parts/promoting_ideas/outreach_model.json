    "initial_state": [
        "No candidates identified.",
        "Segments defined: [Frameworks, AgentProducts, VCs, ResearchLabs]"
    ],
    "goal": [
        "Produce a Markdown file with exactly 20 candidates.",
        "Each candidate has a 'Hook' (why this person?) and 'Contact' info/strategy.",
        "List covers at least 5 Infra and 5 Product targets."
    ],
    "assumptions": [
        "Public information (LinkedIn/Twitter/Blogs) is sufficient to verify role and interest.",
        "User can perform manual email finding if only DM links are found."
    ],
    "unknowns": [],
    "requirement_trace": [
        {
            "requirement": "find the 20 individuals",
            "represented_as": "constraint",
