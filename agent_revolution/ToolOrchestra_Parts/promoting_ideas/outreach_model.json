                "name",
                "priority",
                "examples"
            ]
        }
    ],
    "state_variables": [
        {
            "name": "candidate_pool",
            "type": "List<Candidate>",
            "initial": "[]",
            "description": "List of potential candidates found during search."
        },
        {
            "name": "selected_candidates",
            "type": "List<Candidate>",
            "initial": "[]",
            "description": "The final list of 20 candidates."
        }
    ],
    "actions": [
        {
            "name": "IdentifySegment",
            "description": "Select a target segment to search within.",
            "preconditions": [],
            "effects": [
                "Current search context set to segment"
            ],
            "parameters": [
                "segment_name"
            ]
        },
        {
            "name": "FindCandidate",
            "description": "Locate a specific individual matching the segment criteria.",
            "preconditions": [
                "Segment is defined"
            ],
            "effects": [
                "Candidate added to candidate_pool"
            ],
            "parameters": [
                "name",
                "role",
                "company",
                "source_url"
            ]
        },
        {
            "name": "EvaluateCandidate",
            "description": "Score a candidate against the 'High-Value' criteria.",
            "preconditions": [
                "Candidate is in candidate_pool"
