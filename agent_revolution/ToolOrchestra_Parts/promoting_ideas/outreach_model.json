            "effects": [
                "Candidate assigned relevance_score"
            ],
            "parameters": [
                "candidate_id",
                "technical_authority_evidence",
                "recent_activity_link"
            ]
        },
        {
            "name": "SelectCandidate",
            "description": "Move a qualified candidate to the selected list.",
            "preconditions": [
                "Candidate.relevance_score >= 8",
                "selected_candidates.length < 20",
