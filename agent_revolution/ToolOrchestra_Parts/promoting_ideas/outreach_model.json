            ],
            "effects": [
                "Candidate added to selected_candidates"
            ],
            "parameters": [
                "candidate_id"
            ]
        }
    ],
    "constraints": [
        {
            "id": "C1",
            "statement": "Total selected candidates must be exactly 20.",
