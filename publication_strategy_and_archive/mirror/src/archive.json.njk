---
permalink: archive.json
eleventyExcludeFromCollections: true
---
[
{% for post in archive.posts %}
  {
    "slug": {{ post.slug | json }},
    "title": {{ post.title | json }},
    "summary": {{ post.summary | json }},
    "permalink": {{ post.permalink | url | absoluteUrl(site.siteUrl) | json }},
    "canonical_url": {{ post.url | json }},
    "research_folder": {{ post.researchFolder | json }},
    "tags": {{ post.tags | json }},
    "post_date": {{ post.post_date | json }}
  }{% if not loop.last %},{% endif %}
{% endfor %}
]
