<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ canonicalUrl or (page.url | url | absoluteUrl(site.siteUrl)) }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | url | absoluteUrl(site.siteUrl) }}">
    {% if socialImage %}
    <meta property="og:image" content="{{ socialImage | url | absoluteUrl(site.siteUrl) }}">
    {% endif %}
    <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
    {% for stylesheet in extraStylesheets or [] %}
    <link rel="stylesheet" href="{{ stylesheet | url }}">
    {% endfor %}
    {% for scriptPath in extraScripts or [] %}
    <script defer src="{{ scriptPath | url }}"></script>
    {% endfor %}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <div class="ambient ambient-left"></div>
      <div class="ambient ambient-right"></div>
      <header class="site-header">
        <a class="site-mark" href="{{ '/' | url }}">
          <span class="site-mark__eyebrow">Rooted Layers</span>
          <span class="site-mark__title">Research Mirror</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="{{ '/archive/' | url }}">Archive</a>
          <a href="{{ site.substackUrl }}">Substack</a>
          <a href="{{ site.repoUrl }}">GitHub</a>
        </nav>
      </header>
      <main id="main-content" tabindex="-1">
        {{ content | safe }}
      </main>
      <footer class="site-footer">
        <p class="site-footer__disclosure">{{ archive.portfolio.disclosure }}</p>
        <p>{{ site.publicationTitle }} is published on <a href="{{ site.substackUrl }}">Substack</a>, which remains the canonical publication surface. The <a href="{{ '/archive/' | url }}">complete public archive</a> remains available here.</p>
      </footer>
    </div>
  </body>
</html>
