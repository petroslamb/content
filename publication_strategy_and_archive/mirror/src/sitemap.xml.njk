---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | url | absoluteUrl(site.siteUrl) }}</loc>
  </url>
  <url>
    <loc>{{ '/archive/' | url | absoluteUrl(site.siteUrl) }}</loc>
  </url>
  {% for post in archive.posts %}
  <url>
    <loc>{{ post.permalink | url | absoluteUrl(site.siteUrl) }}</loc>
  </url>
  {% endfor %}
  {% for series in archive.series %}
  <url>
    <loc>{{ series.permalink | url | absoluteUrl(site.siteUrl) }}</loc>
  </url>
  {% endfor %}
</urlset>
